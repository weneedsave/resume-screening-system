# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 忽略，不会提交）
# DeepSeek API Key，在 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 这个模型必须支持图片输入，否则图片简历会解析失败。
# 实测（2026-09-16）：
#   deepseek-v4-flash            支持图片，可用（推荐）
#   deepseek-v4-flash-vision-exp 支持图片，可用
#   deepseek-v4-pro              不支持图片，且不会报错——它会静默丢掉图片、
#                                再凭文本编一个看起来很像的答案。不要用。
DEEPSEEK_MODEL=deepseek-v4-flash

# 大模型接口超时（秒）
AI_TIMEOUT=30

# 本地开发想开热重载和详细报错页时设为 1（默认关闭）
FLASK_DEBUG=0
